{
  "llm-wiki": {
    "SessionStart": [
      {
        "type": "command",
        "command": "\"__UV__\" run --locked --no-sync --directory \"__LLM_WIKI_ROOT__\" python \"__LLM_WIKI_ROOT__/scripts/antigravity_hook.py\"",
        "timeout": 15
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command|write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "\"__UV__\" run --locked --no-sync --directory \"__LLM_WIKI_ROOT__\" python \"__LLM_WIKI_ROOT__/scripts/antigravity_hook.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "\"__UV__\" run --locked --no-sync --directory \"__LLM_WIKI_ROOT__\" python \"__LLM_WIKI_ROOT__/scripts/antigravity_hook.py\"",
        "timeout": 30
      }
    ]
  }
}
